#VRML_SIM R2025a utf8

WorldInfo {
  info [
    "Vision-Based Autonomous Navigation for UGV in Outdoor Environment"
    "Scenario 3: GPS-Denied Challenge"
  ]
  title "Scenario 3 - Vision UGV Outdoor Navigation"
  basicTimeStep 16
  coordinateSystem "ENU"
}

Viewpoint {
  orientation 0.2501 0.5117 -0.8219 1.0729
  position -3.5 -3.5 2.5
  follow "UGV"
  followSmoothness 0.2
}

Background {
  skyColor [ 0.42 0.72 0.98 ]
}

DirectionalLight {
  ambientIntensity 0.65
  color 1.0 0.98 0.92
  direction 0.4 0.3 -0.85
  intensity 2.8
  castShadows TRUE
}

PointLight {
  attenuation 0 0 0.02
  color 0.95 0.98 1.0
  location 0 0 16
  intensity 1.8
}

# Main Outdoor Terrain
DEF TERRAIN_GROUND Solid {
  translation 0 0 0
  children [
    Shape {
      appearance PBRAppearance {
        baseColor 0.28 0.58 0.22
        baseColorMap ImageTexture { url [ "../assets/textures/grass.png" ] }
        roughness 0.85
        metalness 0.0
        textureTransform TextureTransform { scale 24 24 }
      }
      geometry Box { size 38 38 0.1 }
