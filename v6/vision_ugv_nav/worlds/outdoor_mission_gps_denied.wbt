# AUTONOMOUS UNMANNED GROUND VEHICLE (UGV)
DEF UGV Robot {
  translation -10.0 -8.0 0.12
  rotation 0 0 1 0.785
  children [
    Pose {
      translation 0 0 0.08
      children [
        Shape {
          appearance PBRAppearance {
            baseColor 0.22 0.35 0.25
            roughness 0.4
            metalness 0.6
          }
          geometry Box { size 0.55 0.36 0.16 }
        }
      ]
    }
    Pose {
      translation 0.28 0 0.08
      children [
        Shape {
          appearance PBRAppearance {
            baseColor 0.9 0.7 0.1
            baseColorMap ImageTexture { url [ "../assets/textures/hazard.png" ] }
            roughness 0.5
          }
          geometry Box { size 0.04 0.38 0.12 }
        }
      ]
    }
    Pose {
      translation 0.18 0 0.26
      children [
        Shape {
          appearance PBRAppearance { baseColor 0.15 0.15 0.15 metalness 0.8 }
          geometry Cylinder { radius 0.02 height 0.20 }
        }
      ]
    }
    Pose {
      translation 0.22 0 0.36
      rotation 0 1 0 0.21
      children [
        Shape {
          appearance PBRAppearance { baseColor 0.18 0.18 0.18 }
          geometry Box { size 0.08 0.14 0.06 }
        }
        Camera {
          name "ugv_camera"
          translation 0.04 0 0
          width 320
          height 240
          fieldOfView 1.2217
        }
        RangeFinder {
          name "ugv_range_finder"
          translation 0.04 0 0
          width 320
          height 240
          fieldOfView 1.2217
          minRange 0.15
          maxRange 12.0
        }
      ]
    }
    # Left Flank Camera (+45 deg yaw)
    Pose {
      translation 0.20 0.08 0.36
      rotation 0 0 1 0.785398
      children [
        Camera {
          name "ugv_camera_left"
          translation 0.02 0 0
          width 320
          height 240
          fieldOfView 1.2217
        }
      ]
    }
    # Right Flank Camera (-45 deg yaw)
    Pose {
      translation 0.20 -0.08 0.36
      rotation 0 0 1 -0.785398
      children [
        Camera {
          name "ugv_camera_right"
          translation 0.02 0 0
          width 320
          height 240
          fieldOfView 1.2217
        }
      ]
    }
    # Rear Observation Camera (180 deg yaw)
    Pose {
      translation -0.22 0 0.28
      rotation 0 0 1 3.14159
      children [
        Camera {
          name "ugv_camera_rear"
          translation -0.02 0 0
          width 320
          height 240
          fieldOfView 1.2217
        }
      ]
    }
    InertialUnit { name "ugv_imu" }
    Gyro { name "ugv_gyro" }
    Accelerometer { name "ugv_accelerometer" }
    HingeJoint {
      jointParameters HingeJointParameters { axis 0 1 0 anchor 0 0.23 0 }
      device [
        RotationalMotor { name "left_wheel_motor" maxVelocity 10.0 maxTorque 25.0 }
        PositionSensor { name "left_wheel_sensor" }
      ]
      endPoint Solid {
        translation 0 0.23 0
        rotation 1 0 0 1.5708
        children [
          DEF WHEEL_SHAPE Shape {
            appearance PBRAppearance { baseColor 0.15 0.15 0.15 roughness 0.8 }
            geometry Cylinder { radius 0.095 height 0.06 }
          }
        ]
        name "left_wheel"
        boundingObject USE WHEEL_SHAPE
        physics Physics { mass 2.0 }
      }
    }
    HingeJoint {
      jointParameters HingeJointParameters { axis 0 1 0 anchor 0 -0.23 0 }
      device [
        RotationalMotor { name "right_wheel_motor" maxVelocity 10.0 maxTorque 25.0 }
        PositionSensor { name "right_wheel_sensor" }
      ]
      endPoint Solid {
        translation 0 -0.23 0
        rotation 1 0 0 1.5708
        children [ USE WHEEL_SHAPE ]
        name "right_wheel"
        boundingObject USE WHEEL_SHAPE
        physics Physics { mass 2.0 }
      }
    }
    Pose {
      translation 0.22 0 -0.045
      children [
        DEF CASTER_SHAPE Shape {
          appearance PBRAppearance { baseColor 0.35 0.35 0.35 metalness 0.9 }
          geometry Sphere { radius 0.05 }
        }
      ]
    }
    Pose { translation -0.22 0 -0.045 children [ USE CASTER_SHAPE ] }
  ]
  name "UGV_ROBOT"
  boundingObject Group {
    children [
      Pose { translation 0 0 0.08 children [ Box { size 0.55 0.36 0.16 } ] }
      Pose { translation 0.22 0 -0.045 children [ Sphere { radius 0.05 } ] }
      Pose { translation -0.22 0 -0.045 children [ Sphere { radius 0.05 } ] }
    ]
  }
  physics Physics { density -1 mass 16.0 centerOfMass [ 0 0 0.04 ] }
  controller "ugv_controller"
}

# MISSION SUPERVISOR
Robot {
  name "mission_supervisor"
  supervisor TRUE
  controller "supervisor_controller"
}